# ── BusbarX API — environment variables ──────────────────────────────────────
# Copy this file to .env and fill in any overrides you need.
# Never commit .env to source control.

# Port the uvicorn server listens on (Render sets $PORT automatically)
PORT=8000

# Number of background extraction threads (1 per concurrent STEP job)
# Increase on Pro/Pro-Plus instances; keep at 1-2 on Standard (2 GB RAM)
WORKER_THREADS=4

# Log level: debug | info | warning | error
LOG_LEVEL=info

# Optional API key authentication.
# Leave blank to disable auth entirely (suitable for internal VPC calls).
# Set to any strong random string to enable X-API-Key header enforcement.
API_KEY=

# Comma-separated CORS origins (default * = allow all)
# Example: https://app.yoursaas.com,https://staging.yoursaas.com
CORS_ORIGINS=*

# Timeout (seconds) for a single synchronous extraction request.
# Raise if you have very complex geometries.
SINGLE_TIMEOUT_S=120
